# ── Supabase connection ──────────────────────────────────────────────
# Both values live in your Supabase dashboard: Project Settings → API.
# Without a .env the app still runs fully on built-in sample data
# (the admin page shows setup instructions instead of a login).

# Project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# The "anon / public" API key. Safe to expose in the browser — all writes
# are blocked by row-level security unless the teacher is signed in.
# Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=
